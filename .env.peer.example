# =============================================================================
# DFSha — plantilla de .env para UN peer en UNA máquina (despliegue multi-VM)
#
# Copia este archivo a `.env` EN CADA VM y ajusta lo que corresponda. Las tres
# VMs usan el mismo repo, la misma imagen y el mismo docker-compose.peer.yml;
# la ÚNICA diferencia entre ellas es este .env y el certificado individual.
#
# NUNCA subas un .env real a Git: contiene secretos. Esta plantilla solo lleva
# placeholders.
#
# Las variables están agrupadas en tres bloques según quién las comparte:
#   (A) COMUNES AL CLÚSTER   — idénticas en las tres VMs
#   (B) ESPECÍFICAS DEL PEER — distintas en cada VM
#   (C) DESCUBRIMIENTO        — idénticas en las tres VMs (la lista de peers)
# =============================================================================


# -----------------------------------------------------------------------------
# (A) COMUNES AL CLÚSTER  — exactamente los mismos valores en peer1, peer2, peer3
# -----------------------------------------------------------------------------
# Si estos tres secretos difieren entre peers, no se entienden entre sí.

# Modo seguro: exige secretos y HTTPS. En el despliegue multi-VM van en true.
DFSHA_REQUIRE_AUTH=true
DFSHA_REQUIRE_TLS=true

# Secreto de autenticación peer<->peer (cabecera X-Peer-Token).
#   openssl rand -hex 32
DFSHA_PEER_TOKEN=pon-aqui-el-secreto-de-peer-comun

# Credenciales de los usuarios del DFS: usuario=token, separados por comas.
#   cada token: openssl rand -hex 24
DFSHA_USERS=alice=token-de-alice,bob=token-de-bob

# Clave de cifrado en reposo (AES-256-GCM). 32 bytes en hex (64 chars) o base64.
#   openssl rand -hex 32
DFSHA_MASTER_KEY=pon-aqui-32-bytes-en-hex-de-64-caracteres

# Secreto HMAC para firmar las capabilities de bloque.
#   openssl rand -hex 32
DFSHA_CAP_SECRET=pon-aqui-el-secreto-de-capabilities-comun

# Validez de una capability de bloque, en segundos.
DFSHA_CAP_TTL=900

# Parámetros del clúster (iguales en los tres o el anillo/replicación divergen).
DFSHA_REPLICAS=2
DFSHA_BLOCK_SIZE=4194304
DFSHA_VNODES=128


# -----------------------------------------------------------------------------
# (B) ESPECÍFICAS DEL PEER  — distintas en cada VM
# -----------------------------------------------------------------------------
# Esto es lo único que cambia la identidad del peer. En este ejemplo es peer1;
# en VM2 pon peer2 y su IP, en VM3 peer3 y la suya.

# Identidad en el anillo. Estable entre reinicios: si cambia, las claves de
# este peer se remapean y sus bloques quedan inalcanzables.
DFSHA_PEER_ID=peer1

# La dirección que ESTE peer anuncia y por la que los demás lo alcanzan: su IP
# en la VPN (o su DNS privado) + el puerto. Es la fuente de verdad de lo que
# aparece en /ring. NUNCA uses localhost/127.0.0.1 aquí en multi-VM.
#   Ejemplo con la IP de la VPN de la VM de peer1:
DFSHA_ADDRESS=https://10.10.0.11:9001

# Puerto que publica el contenedor. En multi-VM los tres usan el MISMO puerto
# (cada uno en su máquina). Debe coincidir con el puerto de DFSHA_ADDRESS.
DFSHA_PORT=9001

# Raíz de datos DENTRO del contenedor. Se monta desde DFSHA_DATA_DIR del host.
DFSHA_STORAGE_ROOT=/datos

# Path del host donde persisten metadata y bloques de ESTA VM. Independiente
# por máquina; nunca compartido entre VMs.
DFSHA_DATA_DIR=/opt/dfsha/data

# Directorio del host con los certificados de ESTA VM: su peerN.crt, su
# peerN.key y el ca.crt. Se monta de solo lectura en /certs del contenedor.
DFSHA_CERTS_DIR=/opt/dfsha/certs

# Certificado y clave de ESTE peer (rutas dentro del contenedor, bajo /certs).
# En VM2 serían peer2.crt/peer2.key; en VM3, peer3.*.
DFSHA_TLS_CERT=/certs/peer1.crt
DFSHA_TLS_KEY=/certs/peer1.key

# Imagen a ejecutar. La MISMA etiqueta en las tres VMs.
DFSHA_IMAGE=dfsha-peer:latest


# -----------------------------------------------------------------------------
# (C) DESCUBRIMIENTO  — idénticas en las tres VMs
# -----------------------------------------------------------------------------
# El bootstrap es SOLO descubrimiento inicial del anillo, no coordinación:
# ningún peer de la lista tiene privilegios. La lista nombra a los tres por su
# dirección de VPN. Como cada peer figura en su propio bootstrap, coloca a los
# otros dos al arrancar sin hablar con nadie, y el orden de arranque da igual.
DFSHA_BOOTSTRAP=peer1=https://10.10.0.11:9001,peer2=https://10.10.0.12:9001,peer3=https://10.10.0.13:9001

# CA que verifica los certificados de todos los peers. El MISMO ca.crt en las
# tres VMs y en el cliente. La clave de la CA (ca.key) NUNCA se copia a las VMs.
DFSHA_TLS_CA=/certs/ca.crt
