# Configuración de un peer DFSha — SPEC-02
#
# Copiar a .env y ajustar por peer. Los tres peers de la demo comparten el
# MISMO DFSHA_BOOTSTRAP y cambian solo su identidad, su dirección y su raíz de
# datos. Como el bootstrap trae pares peer_id=dirección, cada peer coloca a los
# otros en el anillo sin hablar con ellos: el orden de arranque da igual.

# --- Identidad de ESTE peer ------------------------------------------------
# Es su posición en el anillo. Tiene que ser estable entre reinicios: si
# cambiara, todas sus claves se remapearían y sus bloques quedarían
# inalcanzables.
DFSHA_PEER_ID=peer1
DFSHA_ADDRESS=http://127.0.0.1:9001

# Raíz de datos de ESTE peer. Tres peers en la misma máquina necesitan tres
# directorios distintos o se pisan los bloques.
DFSHA_STORAGE_ROOT=./data/peer1

# --- Membresía (idéntica en los tres) --------------------------------------
DFSHA_BOOTSTRAP=peer1=http://127.0.0.1:9001,peer2=http://127.0.0.1:9002,peer3=http://127.0.0.1:9003

# --- Parámetros del sistema (no hace falta tocarlos) ------------------------
# 4 MiB. El tamaño de bloque entra en juego en la SPEC-03.
DFSHA_BLOCK_SIZE=4194304

# Posiciones virtuales por peer. No bajarlo: con pocas, tres peers reparten mal
# y el reparto que el hito 2 tiene que demostrar deja de verse.
DFSHA_VNODES=128

# --- Los otros dos peers ----------------------------------------------------
# peer2: DFSHA_PEER_ID=peer2  DFSHA_ADDRESS=http://127.0.0.1:9002  DFSHA_STORAGE_ROOT=./data/peer2
# peer3: DFSHA_PEER_ID=peer3  DFSHA_ADDRESS=http://127.0.0.1:9003  DFSHA_STORAGE_ROOT=./data/peer3
